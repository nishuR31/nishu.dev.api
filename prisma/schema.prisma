generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String?
  role            String   @default("developer") // Restricted to "developer"
  googleId        String?  @unique
  twoFactorSecret String?
  is2FAEnabled    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  passkeys        Passkey[]
  portfolioData   PortfolioData?
}

model Passkey {
  id             String @id @default(uuid())
  credentialID   Bytes  @unique
  credentialPublicKey Bytes
  counter        BigInt
  transports     String?
  user           User   @relation(fields: [userId], references: [id])
  userId         String
}

model PortfolioData {
  id           String @id @default(uuid())
  name         String
  shortName    String
  role         String
  tagline      String
  bio          String
  location     String
  email        String
  about        String[]
  recentTracks Boolean @default(true)
  keywords     String  @default("portfolio,developer")

  userId       String @unique
  user         User   @relation(fields: [userId], references: [id])

  social       Social?
  navItems     NavItem[]
  projects     Project[]
  skills       SkillCategory[]
  experiences  Experience[]
  certificates Certificate[]
  cvs          CV[]
}

model Social {
  id        String @id @default(uuid())
  email     String
  github    String
  linkedin  String
  discord   String
  twitter   String
  leetcode  String
  hackerone String

  portfolioId String @unique
  portfolio   PortfolioData @relation(fields: [portfolioId], references: [id])
}

model NavItem {
  id          String @id @default(uuid())
  href        String
  label       String
  portfolioId String
  portfolio   PortfolioData @relation(fields: [portfolioId], references: [id])
}

model Project {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  image        String
  technologies String[]
  github       String?
  demo         String?
  problem      String?
  solution     String?
  role         String?
  timeline     String?
  highlights   String[]
  categories   String[]
  featured     Boolean  @default(false)
  
  portfolioId  String
  portfolio    PortfolioData @relation(fields: [portfolioId], references: [id])
}

model SkillCategory {
  id          String  @id @default(uuid())
  title       String
  iconKey     String
  description String
  bgClass     String
  iconClass   String
  
  skills      Skill[]

  portfolioId String
  portfolio   PortfolioData @relation(fields: [portfolioId], references: [id])
}

model Skill {
  id              String  @id @default(uuid())
  name            String
  level           String
  hot             Boolean @default(false)
  
  skillCategoryId String
  skillCategory   SkillCategory @relation(fields: [skillCategoryId], references: [id])
}

model Experience {
  id               String @id @default(uuid())
  position         String
  company          String
  period           String
  location         String
  description      String
  responsibilities String[]
  technologies     String[]

  portfolioId      String
  portfolio        PortfolioData @relation(fields: [portfolioId], references: [id])
}

model Certificate {
  id          String @id @default(uuid())
  certId      String // The id from original data like 'cert-1'
  title       String
  url         String
  type        String

  portfolioId String
  portfolio   PortfolioData @relation(fields: [portfolioId], references: [id])
}

model CV {
  id           String @id @default(uuid())
  cvId         String // cv-1
  title        String
  url          String
  description  String
  lastUpdated  String

  portfolioId  String
  portfolio    PortfolioData @relation(fields: [portfolioId], references: [id])
}

model SystemSettings {
  id              String   @id @default("global")
  maintenanceMode Boolean  @default(false)
  siteName        String   @default("nishu.dev")
  updatedAt       DateTime @updatedAt
}
